<brls:Box
        wireframe="false"
        highlightCornerRadius="8"
        axis="row"
        width="100%"
        height="70"
        paddingLeft="15"
        paddingRight="15"
        alignItems="center">

    <!-- File/Folder icon -->
    <SVGImage
            id="nas/item/icon"
            width="40"
            height="40"
            marginRight="15"
            SVG="@res/svg/ico-space.svg"/>

    <!-- File info container -->
    <brls:Box
            axis="column"
            grow="1"
            justifyContent="center">

        <!-- File name -->
        <brls:Label
                id="nas/item/name"
                text="filename.mp4"
                fontSize="18"
                singleLine="true"
                textColor="@theme/brls/text"/>

        <!-- File size (for files only) -->
        <brls:Label
                id="nas/item/size"
                text=""
                fontSize="14"
                marginTop="4"
                textColor="@theme/font/grey"/>

    </brls:Box>

    <!-- Arrow indicator for folders -->
    <brls:Label
            id="nas/item/arrow"
            text=">"
            fontSize="20"
            textColor="@theme/font/grey"
            visibility="gone"/>

</brls:Box>
